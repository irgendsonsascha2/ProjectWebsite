# Vorlage für Produktion / Staging (NICHT committen).
# Auf dem Server als .env.local im Projektroot ablegen (oder Variablen im System setzen).
# Lokal testen: Kopie z. B. nach .env.production.local und:
#   set -a && source .env.production.local && set +a && php scripts/deploy-check.php

APP_ENV=production
APP_ALLOW_DEV_DB_DEFAULTS=0

# MongoDB-Host der Produktionsumgebung (z. B. interne DB-IP; nicht öffentlich ans Netz stellen)
APP_DB_NAME=portfolio_db
APP_DB_URI=mongodb://viewer:CHANGE_ME@127.0.0.1:27017/portfolio_db?authSource=portfolio_db
VIEWER_DB_URI=mongodb://viewer:CHANGE_ME@127.0.0.1:27017/portfolio_db?authSource=portfolio_db
COMMUNITY_DB_URI=mongodb://community_member:CHANGE_ME@127.0.0.1:27017/portfolio_db?authSource=portfolio_db
CONTENT_MANAGER_DB_URI=mongodb://content_manager:CHANGE_ME@127.0.0.1:27017/portfolio_db?authSource=portfolio_db
ADMIN_DB_URI=mongodb://admin:CHANGE_ME@127.0.0.1:27017/portfolio_db?authSource=portfolio_db

# Legacy Bridge: öffentliche URL der klassischen PHP-Website
# LEGACY_SITE_URL=https://example.com
# HANDOFF_SECRET=CHANGE_ME
# LEGACY_AFTER_LOGIN_PAGE=home
# TRUSTED_PROXY_IPS=127.0.0.1

# Hinter TLS-Terminierung (Reverse-Proxy)
SESSION_SECURE=1
TRUSTED_PROXY_IPS=127.0.0.1

# SMTP mit TLS (kein Plain-SMTP in Produktion)
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_LOG_REDACT_SECRETS=1
