APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Produktion: APP_ENV=production, APP_DEBUG=false
# Für `php artisan serve` passend halten (Standard: Port 8000).
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb

# Wie nach dbScripts/README: Datenbank portfolio_db; für Laravel-Schreibzugriff typisch Admin-URI (includes/db.php).
# Starke Passwörter — nicht „0“ in Produktion (siehe Projektroot .env.example)
MONGODB_URI=mongodb://admin:CHANGE_ME@localhost:27017/portfolio_db?authSource=portfolio_db
MONGODB_DATABASE=portfolio_db

# SQLITE (braucht PHP pdo_sqlite):
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/to/database.sqlite

# Use "database" only if PHP has PDO for your DB (e.g. pdo_sqlite, pdo_mysql).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS: SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Lokal: smtp → MailHog (make services-up). Alternative: MAIL_MAILER=log → storage/logs/laravel.log
# Produktion: smtp + tls — siehe docs/local_mail_setup.md
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: nach Login/Registrierung auf die alte PHP-App (siehe laravel_handoff.php im Projektroot)
# Exakt wie im Browser inkl. Port, z. B. php -S 127.0.0.1:8080 →
# LEGACY_SITE_URL=http://127.0.0.1:8080
# HANDOFF_SECRET=  (openssl rand -hex 32)
# LEGACY_AFTER_LOGIN_PAGE=home
# TRUSTED_PROXY_IPS=127.0.0.1
