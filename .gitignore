## Media uploads (runtime content)
content/images/*
content/videos/*
!content/images/.gitkeep
!content/videos/.gitkeep

## Local logs / temp
logs/*
!logs/.htaccess

## Node/Frontend build artifacts
frontend/node_modules/
frontend/.vite/
frontend/tsconfig.tsbuildinfo

## Vite output (im Repo nicht versionieren — nach Klon/Änderung: `cd frontend && npm run build`)
react-dist/

## Upload-Scratch (Runtime; optional .gitkeep behalten)
content/tmp/**
!content/tmp/.gitkeep

## Local env overrides (contain secrets)
.env.local
.env

## PHPUnit
.phpunit.cache/

## PHPStan
.phpstan-cache/

## OS/editor
.DS_Store
.idea/
.vscode/

