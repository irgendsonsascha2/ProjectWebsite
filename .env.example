# Kopie nach .env.local (nicht committen). Wird beim PHP-Start aus dem Projektroot geladen.

APP_ENV=local
# Nur für lokale Entwicklung ohne echte Mongo-Passwörter:
APP_ALLOW_DEV_DB_DEFAULTS=1

# MongoDB (nach dbScripts/03 — starke Passwörter in Produktion)
# Optional lokal: docker compose up -d  → mongodb://localhost:27017
APP_DB_NAME=portfolio_db
APP_DB_URI=mongodb://viewer:CHANGE_ME@localhost:27017/portfolio_db?authSource=portfolio_db
VIEWER_DB_URI=mongodb://viewer:CHANGE_ME@localhost:27017/portfolio_db?authSource=portfolio_db
COMMUNITY_DB_URI=mongodb://community_member:CHANGE_ME@localhost:27017/portfolio_db?authSource=portfolio_db
CONTENT_MANAGER_DB_URI=mongodb://content_manager:CHANGE_ME@localhost:27017/portfolio_db?authSource=portfolio_db
ADMIN_DB_URI=mongodb://admin:CHANGE_ME@localhost:27017/portfolio_db?authSource=portfolio_db

# Session (HTTPS/Proxy): SESSION_SECURE=1 setzen
# SESSION_SECURE=0

# Reverse-Proxy: kommagetrennte IPs, die X-Forwarded-For liefern dürfen
# TRUSTED_PROXY_IPS=127.0.0.1

# Mail (lokal MailHog: HOST=127.0.0.1 PORT=1025, ENCRYPTION weglassen oder none)
# MAIL_SMTP_HOST=127.0.0.1
# MAIL_SMTP_PORT=1025
# MAIL_SMTP_ENCRYPTION=tls
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# MAIL_FROM_EMAIL=no-reply@localhost
# MAIL_LOG_REDACT_SECRETS=1
